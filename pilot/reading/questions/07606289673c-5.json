d3843e8756b75da56c2d795973e811f5b4f74b770ff86b4b","d2d57b60bdb98af809cad0a2b9c04da8206be6ca4f956dcd0333efb91e0d5d8e","dbd9866c12d5152fb5f2b07d8bc99f6a2422085b48c6fbba39ae59be36f9227f","e765768c13e1a214a03bea4f7c6c6a0736373d4436902ac017c26346e58b1ffe","ebdc74b3710e95bd62555b1449dcd083fe19ef2a1ad6e5e99f112cbadab16dab"],"sourceSha256":"167a4cf00dbcaeca6c948a0cb6d3d50571409e6ad3e57175903519c8e8fa330f"},"2026.5.28:P07-Q03":{"html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>王水溶金中的粒子计数</title><!--chem-style:3f988976c5a5937e0558eab589702caac8cb68489be57106907d457df806601d--></head><body><main><a class=\"back\" href=\"../../../../%E9%98%85%E8%AF%BB%E5%85%A5%E5%8F%A3.html\">← 返回题库</a><div class=\"eyebrow\">2026.5.28 · 长沙市一中一模 · 原题3 · P07-Q03</div><h1>王水溶金中的粒子计数</h1><div class=\"tags\"><span class=\"tag main-tag\">主类别：认识化学科学/物质的量/阿伏加德罗常数</span></div><p class=\"rationale\">分类依据：综合氯离子浓度、标准状况气体、中子数和转移电子。</p><details><summary>相关知识点</summary><div class=\"tags\"><span class=\"tag\">认识化学科学/物质的量/物质的量及单位——摩尔</span><span class=\"tag\">物质结构与性质/原子结构 化学键/原子的构成结构</span><span class=\"tag\">物质结构与性质/分子结构与性质/配合物</span><span class=\"tag\">认识化学科学/氧化还原反应/氧化还原反应的应用/氧化还原反应有关计算</span></div></details><div class=\"card original\"><details><summary>展开原题题干与配图</summary><div><p>可能用到的相对原子质量：<img src=\"chem-asset:3584d8b3dc7b6a299b22f4c0e1957245805d1279ddedb1e4cdcc7784668aeffe:0;\" style=\"width:37.33px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:29961abe4ca4eb9bc4000d3db482888a54ef31d2744adf4e2fcd002cf794c573:1;\" style=\"width:45.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:ba18281314e3bbcbfb8940312159a023bfcb781fde6d6ae6f911ec8acfd27ef9:2;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:731750cfe449eac074601f625765a26f053896498fafad565cbf2d76c97c5daa:3;\" style=\"width:47.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:f150b23f6243951eedb67a1224de7d0650672c978ce62c7cfa4f82e9b94d600d:4;\" style=\"width:56.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:7926ae4510cedcd7435fe375327529849c4f9590aa79df6947956ffed96b49f2:5;\" style=\"width:44.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:361e1d524f5c0c058e50d2296abcd6912fb9de6224953e0cf6da9f6e719e3218:6;\" style=\"width:53.33px;\" alt=\"原文图形或公式\" loading=\"lazy\"> <img src=\"chem-asset:64e621d7fe55ffb3b5530915c1caaf11ab78dfade8c68ebe8506b67f5142aba3:7;\" style=\"width:58.67px;\" alt=\"原文图形或公式\" loading=\"lazy\"></p><p>3. 王水溶金的主要反应为<img src=\"chem-asset:b1effea1e344ffaf8355e9cad9cb777a22abcd84bb74927a914a4404217aa065:8;\" style=\"width:312.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">。用<img src=\"chem-asset:d8b68a9d309cf7689d828e2e60d480c3af323d5b1a71bf42f66a9f8d5efced79:9;\" style=\"width:25.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">代表阿伏加德罗常数的值，下列叙述正确的是</p><p>A. 王水中浓盐酸的浓度为<img src=\"chem-asset:974b4490e39685eb53be7c8e9949786afdb0bbe3b94f2a6ef044e1ff68e43cbb:10;\" style=\"width:63.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，<img src=\"chem-asset:ddf581a8c8e4075c6c453a8c66e18b2678449e5a08b37e68d04e42d61bb1b4b4:11;\" style=\"width:53.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">王水中氯离子的数目小于<img src=\"chem-asset:1819f341c7f4ffabf74d183f5a6516f3291451c167d95dbdc3777a3f0feee9d4:12;\" style=\"width:43.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"></p><p>B. 标准状况下，生成<img src=\"chem-asset:57ced56587cc7aa7e747df93da8b295611ec17020dacf852d98bfa1002055cd7:13;\" style=\"width:88.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">气体，该气体所含中子数为<img src=\"chem-asset:b1e1b7f78ec92967c879b3308a7dcda86cc6688d903d62e62263aea003cae1e3:14;\" style=\"width:52.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"></p><p>C. 含<img src=\"chem-asset:93b66ce4fb8b8d3aeb1fd2e1a1c27e966bd8a124c5bd18bf54a37131a93e56c0:15;\" style=\"width:101.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">的溶液中共价键的数目为<img src=\"chem-asset:82830e91428803fdf6f1c4b8bdd96c6e1a7ccc38012dba720f06a08ac4cbd5e3:16;\" style=\"width:33.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"></p><p>D. 当有<img src=\"chem-asset:919e608507bf44f4fadbe48db7d015ac4cf10d68986224031ee01533ef8c8d55:17;\" style=\"width:80.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">参与反应时转移电子数为<img src=\"chem-asset:80fc219323b992d6725c3c3de93d91fb0dd214ae0fe48248095a6b144dc9f7d6:18;\" style=\"width:40.00px;\" alt=\"原文图形或公式\" loading=\"lazy\"></p></div></details><h2>原答案</h2><div class=\"answers\"><p>【答案】B</p></div><h2>原解析</h2><div class=\"analysis\"><p>【解析】</p><p>【详解】A．若王水中浓盐酸浓度为<img src=\"chem-asset:0e4af4b1b8c0826f0d465db59ae5be4fdc72b4e012accb3d1f25815a299af732:19;\" style=\"width:65.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，<img src=\"chem-asset:b26f59259fa51b3642fbb79c5d3c7e4589b1d499be19a8505c85d85212e9a38d:20;\" style=\"width:49.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">王水中<img src=\"chem-asset:201ee4f0e62557cc3b2288908777413a99305ec728d0d98c7b18dcee4528cf6f:21;\" style=\"width:228.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，氯离子数目等于<img src=\"chem-asset:66ffeecaa93f47922e4e51eb0b25c0bee136006f4a574cae40438a191a0696c0:22;\" style=\"width:44.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，A错误；</p><p>B．标准状况下<img src=\"chem-asset:42664daaf777cefd70979af3824221a3e7775d711f7cf16828974d6015624ac7:23;\" style=\"width:87.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">的物质的量为<img src=\"chem-asset:523d10978a3e4ab233d9bcf4efbd7de446b64a38aa7c63be8cc35ae0781657b9:24;\" style=\"width:140.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，1个<img src=\"chem-asset:396bdc4e881f2cd4f7d0ee3cbc83605ca2ad30a604bc8293a2e4146fb61e1c93:25;\" style=\"width:39.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">分子含中子数为<img src=\"chem-asset:ceba2de172607715750d5746294c6e6d2d8fc371511f90a11f47809ed2bdcb56:26;\" style=\"width:145.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，故所含中子数为<img src=\"chem-asset:d51da39a8f85cc8e2786780eeecc6b7d23f13826f0517afa755c28103dffc600:27;\" style=\"width:135.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，B正确；</p><p>C．溶液中除了<img src=\"chem-asset:163ce92aada53bf65922af54212abb15ae2a3f36f5f3bdcc895b0dfb7eee038e:28;\" style=\"width:61.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">内的共价键，还有大量水分子中的共价键，共价键数目远大于<img src=\"chem-asset:82830e91428803fdf6f1c4b8bdd96c6e1a7ccc38012dba720f06a08ac4cbd5e3:29;\" style=\"width:33.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，C错误；</p><p>D．反应中<img src=\"chem-asset:b3b79cade09b34801974eeaa59f8e617346d6f81d372c9227f4b3491ae7ae812:30;\" style=\"width:44.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">​中N元素从+5价降为NO中的+2价，1mol <img src=\"chem-asset:b3b79cade09b34801974eeaa59f8e617346d6f81d372c9227f4b3491ae7ae812:30;\" style=\"width:44.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">​参与反应转移3mol电子，因此5mol <img src=\"chem-asset:b3b79cade09b34801974eeaa59f8e617346d6f81d372c9227f4b3491ae7ae812:30;\" style=\"width:44.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">参与反应时转移电子数为 <img src=\"chem-asset:06f3c26737b64589397224bd73576e8d1679df7021d33913fab08c2d0079d34e:31;\" style=\"width:39.20px;\" alt=\"原文图形或公式\" loading=\"lazy\">，D错误；</p><p>故选B。</p></div></div><p class=\"note\">原答案和解析按原内容保留，未逐题独立重解或校订。知识点及小问标签为本次整理标注。</p><details><summary>来源与核对</summary><p>D:\\高中化学\\01_资料层\\高中试卷\\2026.5.28\\精品解析：湖南长沙市第一中学2026届高三下学期一模化学试题\\精品解析：湖南长沙市第一中学2026届高三下学期一模化学试题（解析版）.docx</p><a href=\"file:///D:/%E9%AB%98%E4%B8%AD%E5%8C%96%E5%AD%A6/01_%E8%B5%84%E6%96%99%E5%B1%82/%E9%AB%98%E4%B8%AD%E8%AF%95%E5%8D%B7/2026.5.28/%E7%B2%BE%E5%93%81%E8%A7%A3%E6%9E%90%EF%BC%9A%E6%B9%96%E5%8D%97%E9%95%BF%E6%B2%99%E5%B8%82%E7%AC%AC%E4%B8%80%E4%B8%AD%E5%AD%A62026%E5%B1%8A%E9%AB%98%E4%B8%89%E4%B8%8B%E5%AD%A6%E6%9C%9F%E4%B8%80%E6%A8%A1%E5%8C%96%E5%AD%A6%E8%AF%95%E9%A2%98/%E7%B2%BE%E5%93%81%E8%A7%A3%E6%9E%90%EF%BC%9A%E6%B9%96%E5%8D%97%E9%95%BF%E6%B2%99%E5%B8%82%E7%AC%AC%E4%B8%80%E4%B8%AD%E5%AD%A62026%E5%B1%8A%E9%AB%98%E4%B8%89%E4%B8%8B%E5%AD%A6%E6%9C%9F%E4%B8%80%E6%A8%A1%E5%8C%96%E5%AD%A6%E8%AF%95%E9%A2%98%EF%BC%88%E8%A7%A3%E6%9E%90%E7%89%88%EF%BC%89.docx\">打开原来源文件</a></details></main></body></html>","assets":["06f3c26737b64589397224bd73576e8d1679df7021d33913fab08c2d0079d34e",