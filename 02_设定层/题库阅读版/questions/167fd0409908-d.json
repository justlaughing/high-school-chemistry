A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/8d80fa513f8225938f08b5e5.png?v=2","chem-asset:da328c94e33c3986ac2e41f8db6492b5783be450086102b18f55a99135afaa34:13;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/90aa19c2fbc474c077261a2c.png?v=2","chem-asset:33f93e50b1a94b4e09328832eda40af0b9aeecccb463e83c5741591f0e803eec:14;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/d846581564c1533c255804d8.png?v=2","chem-asset:5be2a15b9a7dd166c6eeda32d4300e33afe7e2f550e81b61b65ca3f8e2cb3f7c:15;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/6e3f9e23bf5912f55fb284f3.png?v=2","chem-asset:72eb5215721c760629ca0d1af82ae45a69259d0afc13631e96ad1cf1b4bb6114:16;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/6645bcceaeac3b08d94218b2.png?v=2","chem-asset:aa84fdec1f01661d0ec0c1df7cbf7bf59cf42fb7e612fba1cbe33149f2c5ab43:17;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/66be977ccd97058a166844ee.png?v=2","chem-asset:6f96cb026c2b3530eec9a8596e9648fb0c3685e554845705149942d65ddb6931:18;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/62b3576d691de0df36734fbc.png?v=2","chem-asset:1215bdba34cf6b53d2f1e502c90a08c80d9e0267d38507ba855f34307f6e9dad:19;":"../../../%E6%89%B9%E6%AC%A1%E8%AE%B0%E5%BD%95/2026.6.13/assets/10b020a56a5fc015c038f9de.png?v=2"},"sourceSha256":"ea28552ab7fc564eab13168146854daa82fb88361f014a708cc075a82ef99c06","bom":false,"legacyPath":"化学反应原理/化学平衡/化学平衡常数/P03-Q10_丙烷制丙酸的平衡常数.html"},"2026.6.13:P04-Q04":{"html":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>物质性质的结构解释</title><!--chem-style:3f988976c5a5937e0558eab589702caac8cb68489be57106907d457df806601d--></head><body><main><a class=\"back\" href=\"../../../%E9%98%85%E8%AF%BB%E5%85%A5%E5%8F%A3.html\">← 返回题库</a><div class=\"eyebrow\">2026.6.13 · 实验中学 · 第4题 · P04-Q04</div><h1>物质性质的结构解释</h1><div class=\"tags\"><span class=\"tag main-tag\">主类别：物质结构与性质/分子结构与性质/分子的性质</span></div><p class=\"rationale\">分类依据：比较极性、氢键、金属键、杂化和诱导效应。</p><details><summary>相关知识点</summary><div class=\"tags\"><span class=\"tag\">物质结构与性质/分子结构与性质/分子的构型及相关理论</span><span class=\"tag\">物质结构与性质/原子结构 化学键/分子间作用力</span><span class=\"tag\">物质结构与性质/晶体结构与性质/常见几种晶体类型</span><span class=\"tag\">物质结构与性质/原子结构与性质/电离能 电负性</span><span class=\"tag\">有机化学基础/烃的衍生物/羧酸</span></div></details><div class=\"card original\"><details><summary>展开原题题干与配图</summary><div><p>可能用到的相对原子质量：H-1  C-12  N-14  O-16  S-32  K-39  Cu-64</p><p>4. 下列对物质性质的解释错误的是</p><div class=\"table-wrap\"><table><tr><td colspan=\"1\" rowspan=\"1\"><p>选项</p></td><td colspan=\"1\" rowspan=\"1\"><p>物质性质</p></td><td colspan=\"1\" rowspan=\"1\"><p>解释</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>A</p></td><td colspan=\"1\" rowspan=\"1\"><p><img src=\"chem-asset:5be72f7f37462803b95db313d9ddba17b2ac44bc9d54010fb6e0163673bb004b:0;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">微溶于水，<img src=\"chem-asset:feceec9e5372feb3b1823f1e8eb84432eda5c0f206b9dc79bc4e30d28d4dde99:1;\" style=\"width:36.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">难溶于水</p></td><td colspan=\"1\" rowspan=\"1\"><p><img src=\"chem-asset:5be72f7f37462803b95db313d9ddba17b2ac44bc9d54010fb6e0163673bb004b:0;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">与水能形成氢键，而<img src=\"chem-asset:feceec9e5372feb3b1823f1e8eb84432eda5c0f206b9dc79bc4e30d28d4dde99:1;\" style=\"width:36.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">不能</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>B</p></td><td colspan=\"1\" rowspan=\"1\"><p>铜的熔点高于钠</p></td><td colspan=\"1\" rowspan=\"1\"><p>Cu的金属键比Na的强</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>C</p></td><td colspan=\"1\" rowspan=\"1\"><p><img src=\"chem-asset:837fbd6aafac6c66c85005df8289d0047d91a001fdb2839368266b4b307e9296:2;\" style=\"width:28.93px;\" alt=\"原文图形或公式\" loading=\"lazy\">的键角大于<img src=\"chem-asset:ea2dccee1bc5b42f8f6687f11b8e5781328ae0abe8f31dce00b63e3f5768458b:3;\" style=\"width:32.87px;\" alt=\"原文图形或公式\" loading=\"lazy\">的键角</p></td><td colspan=\"1\" rowspan=\"1\"><p>二者的S原子杂化类型不同</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>D</p></td><td colspan=\"1\" rowspan=\"1\"><p><img src=\"chem-asset:6f6df9761ef1353a47cc03b3dd4612a7be5fd8c37e2cb63d11a4e871d62669d2:4;\" style=\"width:73.07px;\" alt=\"原文图形或公式\" loading=\"lazy\">的酸性比<img src=\"chem-asset:2955ee1e0d918fed0b57798d6d3f5ad2cb59340e51cbfc88fb916f0c6da78f2d:5;\" style=\"width:81.07px;\" alt=\"原文图形或公式\" loading=\"lazy\">强</p></td><td colspan=\"1\" rowspan=\"1\"><p>F的电负性比Cl大</p></td></tr></table></div><p>A. A　B. B　C. C　D. D</p></div></details><h2>原答案</h2><div class=\"answers\"><p>【答案】A</p></div><h2>原解析</h2><div class=\"analysis\"><p>【解析】</p><p>【详解】A．<img src=\"chem-asset:bda39319e5b53d44df1a877ac23a6334f120531567a0180fbf5428751fceb6f5:6;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">中不存在与N、O、F直接相连的H，也不含N、O、F原子，无法与水形成氢键，二者溶解性差异是因为<img src=\"chem-asset:bda39319e5b53d44df1a877ac23a6334f120531567a0180fbf5428751fceb6f5:6;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">为极性分子，<img src=\"chem-asset:d40ca7223e50d24230e7572b2d9de0eeaa2c89bc01529b2d5e33f34d9dcbca70:7;\" style=\"width:36.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">为非极性分子，根据相似相溶原理，极性的<img src=\"chem-asset:bda39319e5b53d44df1a877ac23a6334f120531567a0180fbf5428751fceb6f5:6;\" style=\"width:48.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">微溶于极性的水，非极性的<img src=\"chem-asset:d40ca7223e50d24230e7572b2d9de0eeaa2c89bc01529b2d5e33f34d9dcbca70:7;\" style=\"width:36.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">难溶于水，A错误；</p><p>B．金属晶体熔点取决于金属键强弱，Cu的阳离子电荷更高、半径更小，金属键强于Na，故铜的熔点高于钠，B正确；</p><p>C．<img src=\"chem-asset:6293c77afeb670d475207c6a96896b7178b9ac331194584a82048177ceec2c45:8;\" style=\"width:28.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">中S的价层电子对数=σ键+孤电子对数<img src=\"chem-asset:fa7184003add8b539eba24c4bb9dfd91bc01f9489be735598dd9406b3c8fadce:9;\" style=\"width:113.13px;\" alt=\"原文图形或公式\" loading=\"lazy\">，采取<img src=\"chem-asset:7e9f73b6076dafcebd931e0a79482bb9340a0fb0cf2d46b3d86e8d68e3668b23:10;\" style=\"width:25.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">杂化，为平面三角形结构，键角120°；<img src=\"chem-asset:0999ad038689c9bda00bc459b4e462d7d111adcd9439fd7065a08d6b91952fb2:11;\" style=\"width:36.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">中S的价层电子对数=σ键+孤电子对数<img src=\"chem-asset:ff3ffbdbe5f266de9fd8b378c6148d34f4c3cc5f427400cf1e47dcd45bc844a3:12;\" style=\"width:127.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，采取<img src=\"chem-asset:865467581fa5a8aa0b6c6dd911d59395b20095a1aacaf2e328d53338168fb4a4:13;\" style=\"width:25.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">杂化，为正四面体结构，键角约109°28′，二者杂化类型不同导致键角不同，C正确；</p><p>D．F的电负性大于Cl，吸电子诱导效应更强，使<img src=\"chem-asset:99a3a040de35e394873df1e5ec90363e33f2986604a416289d754ddd9f293ef2:14;\" style=\"width:76.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">中羧基的O-H键极性更强，更易电离出<img src=\"chem-asset:aa30653b75e73dfdb0e41d84576c0d1c3e6e1a5facf48a320b4a8924a6159158:15;\" style=\"width:23.00px;\" alt=\"原文图形或公式\" loading=\"lazy\">，故酸性更强，D正确；</p><p>故选A。</p></div></div><p class=\"note\">本页保存原卷答案与解析。知识点标签和分类依据为本次整理结果；未逐题独立重解或校订原解析。</p><details><summary>来源与核对</summary><p>精品解析：湖南长沙市实验中学2026届高三第九次阶段性测试 化学试卷（解析版）.docx</p><p class=\"source-path\">D:\\高中化学\\01_资料层\\高中试卷\\2026.6.13\\精品解析：湖南长沙市实验中学2026届高三第九次阶段性测试 化学试卷\\精品解析：湖南长沙市实验中学2026届高三第九次阶段性测试 化学试卷（解析版）.docx</p><p><a href=\"file:///D:/%E9%AB%98%E4%B8%AD%E5%8C%96%E5%AD%A6/01_%E8%B5%84%E6%96%99%E5%B1%82/%E9%AB%98%E4%B8%AD%E8%AF%95%E5%8D%B7/2026.6.13/%E7%B2%BE%E5%93%81%E8%A7%A3%E6%9E%90%EF%BC%9A%E6%B9%96%E5%8D%97%E9%95%BF%E6%B2%99%E5%B8%82%E5%AE%9E%E9%AA%8C%E4%B8%AD%E5%AD%A62026%E5%B1%8A%E9%AB%98%E4%B8%89%E7%AC%AC%E4%B9%9D%E6%AC%A1%E9%98%B6%E6%AE%B5%E6%80%A7%E6%B5%8B%E8%AF%95%20%E5%8C%96%E5%AD%A6%E8%AF%95%E5%8D%B7/%E7%B2%BE%E5%93%81%E8%A7%A3%E6%9E%90%EF%BC%9A%E6%B9%96%E5%8D%97%E9%95%BF%E6%B2%99%E5%B8%82%E5%AE%9E%E9%AA%8C%E4%B8%AD%E5%AD%A62026%E5%B1%8A%E9%AB%98%E4%B8%89%E7%AC%AC%E4%B9%9D%E6%AC%A1%E9%98%B6%E6%AE%B5%E6%80%A7%E6%B5%8B%E8%AF%95%20%E5%8C%96%E5%AD%A6