/D:/%E9%AB%98%E4%B8%AD%E5%8C%96%E5%AD%A6/01_%E8%B5%84%E6%96%99%E5%B1%82/%E9%AB%98%E4%B8%AD%E8%AF%95%E5%8D%B7/2026.3.9/%E6%B9%96%E5%8D%97%E9%95%BF%E6%B2%99%E5%B8%82%E9%9B%85%E7%A4%BC%E4%B8%AD%E5%AD%A62026%E5%B1%8A%E9%AB%98%E4%B8%89%E4%B8%8B%E5%AD%A6%E6%9C%9F%E6%A8%A1%E6%8B%9F%E9%A2%84%E6%B5%8B%E5%8C%96%E5%AD%A6%E8%AF%95%E9%A2%98/%E9%AB%98%E4%B8%89%E5%8C%96%E5%AD%A6%E7%AD%94%E6%A1%88.pdf\">D:\\高中化学\\01_资料层\\高中试卷\\2026.3.9\\湖南长沙市雅礼中学2026届高三下学期模拟预测化学试题\\高三化学答案.pdf</a></p></details></main></body></html>","assets":["7c09d2ddd5fcc21dfcb8d562ecd389446365a8efad75c7f52fec1d1338874894","cb4b7f6303e2e2179b5ad5d0c189a46540133d45c7b174032458ad0b4f9bc723","d167c0dc14dd4e0399d0a0ae9147769c44115d6a39ee1cb6504ae8d508dc9deb"],"refs":{"chem-asset:d167c0dc14dd4e0399d0a0ae9147769c44115d6a39ee1cb6504ae8d508dc9deb:0;":"../../../%E5%9B%BE%E7%89%87%E7%B4%A0%E6%9D%90/d167c0dc14dd4e0399d0a0ae.png","chem-asset:7c09d2ddd5fcc21dfcb8d562ecd389446365a8efad75c7f52fec1d1338874894:1;":"../../../%E5%9B%BE%E7%89%87%E7%B4%A0%E6%9D%90/7c09d2ddd5fcc21dfcb8d562.png","chem-asset:cb4b7f6303e2e2179b5ad5d0c189a46540133d45c7b174032458ad0b4f9bc723:2;":"../../../%E5%9B%BE%E7%89%87%E7%B4%A0%E6%9D%90/cb4b7f6303e2e2179b5ad5d0.png"},"sourceSha256":"eab2db690e69d2f5c2068a2dc3f4972bad79800f1013977e97a9213afc3f0274","bom":false,"legacyPath":"认识化学科学/化学用语/2026.3.9/P12-Q02_聚丙烯烯烃命名与氯成键.html"}}